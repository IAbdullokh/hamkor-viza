# Copy to .env.local (gitignored) and change what you need.

# The published server whose /api this dashboard reads; `npm run dev` proxies /api there.
VITE_API_BASE=https://hamkor-viza.data365dashboard.uz

# Leave empty: the built app calls same-origin /api (serve dist/ from the dashboard's domain or behind a reverse proxy).
# 1 = the built app calls VITE_API_BASE cross-origin (only if that server allows CORS with credentials).
VITE_API_DIRECT=

# Only for `npm run snapshot` (saves real data into data/, gitignored). Never commit these.
VIEWER_LOGIN=
VIEWER_PASSWORD=
